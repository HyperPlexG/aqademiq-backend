// Aqademiq data model — reconciled to the deployed Supabase Postgres schema
// (project xqnjquozcnwmogipowpf, schema public, 30 tables). Identity is provided
// by Supabase Auth: profiles.id = auth.users.id and every other user_id FKs to
// auth.users.id. auth.users lives in the `auth` schema and is NOT modeled here,
// so those references are plain uuid columns with no Prisma relation.
generator client {
  provider = "prisma-client-js"
}

// Deno client for Supabase Edge Functions (supabase/functions/*) — Rust-free
// engine (query compiler) + driver adapter, since the default binary engine
// cannot run in the edge sandbox. Output is generated, not committed.
generator edge {
  provider     = "prisma-client"
  output       = "../supabase/functions/_shared/prisma"
  runtime      = "deno"
  moduleFormat = "esm"
  engineType   = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// PART A — Identity & Access
// ============================================================

model Profile {
  id                  String    @id @db.Uuid // = auth.users.id
  email               String?   @db.VarChar(255)
  full_name           String?   @db.VarChar(255)
  display_name        String?   @db.VarChar(100)
  gender              String?   @db.VarChar(50)
  date_of_birth       DateTime? @db.Date
  age                 Int? // captured at onboarding; CHECK (age is null or 1..120)
  avatar_url          String?
  timezone            String    @default("UTC") @db.VarChar(100)
  account_status      String    @default("active") @db.VarChar(20)
  is_guest            Boolean   @default(false)
  onboarding_complete Boolean   @default(false)
  onboarding_step     Int       @default(0) @db.SmallInt
  consent_given       Boolean   @default(false) // data-use consent (recorded at onboarding)
  consent_timestamp   DateTime? @db.Timestamptz // server time consent was recorded; null until consented
  consent_version     String? // Privacy Policy / Terms version accepted (PDPL audit trail)
  referral_code       String?   @unique @db.VarChar(50)
  referred_by         String?   @db.Uuid // -> auth.users.id
  streak_days         Int       @default(0)
  last_active_date    DateTime? @db.Date
  last_login_at       DateTime? @db.Timestamptz
  deleted_at          DateTime? @db.Timestamptz
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @default(now()) @db.Timestamptz

  @@map("profiles")
}

model UserProfile {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String    @unique @db.Uuid // FK -> auth.users.id
  university              String?   @db.VarChar(255)
  program                 String?   @db.VarChar(255)
  study_level             String?   @db.VarChar(100)
  peak_time               String?   @db.VarChar(50)
  daily_focus_goal_mins   Int       @default(60)
  focus_duration_mins     Int       @default(25)
  break_duration_mins     Int       @default(5)
  haptics_enabled         Boolean   @default(true)
  onboarding_completed_at DateTime? @db.Timestamptz
  referral_code_used      String?   @db.VarChar(50)
  created_at              DateTime  @default(now()) @db.Timestamptz
  updated_at              DateTime  @default(now()) @db.Timestamptz

  @@map("user_profiles")
}

model UserAppSettings {
  id                             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                        String   @unique @db.Uuid // FK -> auth.users.id
  appearance                     String   @default("system") @db.VarChar(20)
  accent_color                   String   @default("#6b5cf0") @db.VarChar(7)
  subjects_layout                String   @default("list") @db.VarChar(20)
  focus_timer_style              String   @default("ice_melt") @db.VarChar(50)
  haptics_enabled                Boolean  @default(true)
  play_prism_in_focus            Boolean  @default(true)
  in_app_sounds_enabled          Boolean  @default(true)
  sound_create_task_enabled      Boolean  @default(true)
  sound_complete_task_enabled    Boolean  @default(true)
  sound_task_countdown_enabled   Boolean  @default(true)
  sound_subtask_complete_enabled Boolean  @default(true)
  created_at                     DateTime @default(now()) @db.Timestamptz
  updated_at                     DateTime @default(now()) @db.Timestamptz

  @@map("user_app_settings")
}

model NotificationPreferences {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                    String   @unique @db.Uuid // FK -> auth.users.id
  push_enabled               Boolean  @default(true)
  email_enabled              Boolean  @default(true)
  before_task_enabled        Boolean  @default(true)
  when_task_starts_enabled   Boolean  @default(true)
  halfway_through_enabled    Boolean  @default(false)
  when_task_finished_enabled Boolean  @default(false)
  morning_checkin_enabled    Boolean  @default(true)
  morning_checkin_time       DateTime @default(dbgenerated("'08:00:00'::time without time zone")) @db.Time
  evening_review_enabled     Boolean  @default(true)
  evening_review_time        DateTime @default(dbgenerated("'20:00:00'::time without time zone")) @db.Time
  weekly_review_enabled      Boolean  @default(true)
  weekly_review_day          Int      @default(0) @db.SmallInt
  weekly_review_time         DateTime @default(dbgenerated("'15:00:00'::time without time zone")) @db.Time
  state_of_mind_reminder     Boolean  @default(true)
  motivational_enabled       Boolean  @default(true)
  product_updates_enabled    Boolean  @default(false)
  notification_sound         String   @default("Chime") @db.VarChar(100)
  created_at                 DateTime @default(now()) @db.Timestamptz
  updated_at                 DateTime @default(now()) @db.Timestamptz

  @@map("notification_preferences")
}

model StudyTag {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?  @db.Uuid // FK -> auth.users.id
  name       String   @db.VarChar(100)
  color      String?  @db.VarChar(7)
  is_system  Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz

  @@map("study_tags")
}

model CalendarConnection {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid // FK -> auth.users.id
  provider          String    @db.VarChar(50)
  access_token_enc  String
  refresh_token_enc String?
  token_expires_at  DateTime? @db.Timestamptz
  calendar_email    String?   @db.VarChar(255)
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @default(now()) @db.Timestamptz

  calendar_events   CalendarEvent[]

  @@map("calendar_connections")
}

model DeviceProfile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid // FK -> auth.users.id
  device_name    String?  @db.VarChar(255)
  device_type    String?  @db.VarChar(100)
  push_token     String?
  biometric_sync Boolean  @default(false)
  registered_at  DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @default(now()) @db.Timestamptz

  @@map("device_profiles")
}

// ============================================================
// PART B — Academic Structure
// ============================================================

model AcademicTerm {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid // FK -> auth.users.id
  name       String    @db.VarChar(100)
  start_date DateTime? @db.Date
  end_date   DateTime? @db.Date
  is_current Boolean   @default(false)
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @default(now()) @db.Timestamptz

  courses    Course[]

  @@unique([user_id, name])
  @@map("academic_terms")
}

model Course {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String        @db.Uuid // FK -> auth.users.id
  term_id            String?       @db.Uuid
  term               AcademicTerm? @relation(fields: [term_id], references: [id], onDelete: SetNull)
  name               String        @db.VarChar(255)
  code               String?       @db.VarChar(50)
  professor          String?       @db.VarChar(255)
  color              String?       @db.VarChar(7)
  credits            Decimal?      @db.Decimal(4, 1)
  grade_system       String        @default("letter") @db.VarChar(20)
  target_grade_text  String?       @db.VarChar(20)
  target_gpa         Decimal?      @db.Decimal(3, 2)
  target_percentage  Decimal?      @db.Decimal(5, 2)
  current_gpa        Decimal?      @db.Decimal(3, 2)
  current_percentage Decimal?      @db.Decimal(5, 2)
  subject_feeling    Int?          @db.SmallInt
  syllabus_status    String        @default("missing") @db.VarChar(30)
  sort_order         Int           @default(0)
  is_archived        Boolean       @default(false)
  archived_at        DateTime?     @db.Timestamptz
  created_at         DateTime      @default(now()) @db.Timestamptz
  updated_at         DateTime      @default(now()) @db.Timestamptz

  subject_materials  SubjectMaterial[]
  tasks              Task[]
  focus_sessions     FocusSession[]
  ada_sessions       AdaSession[]

  @@map("courses")
}

model SubjectMaterial {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String   @db.Uuid // FK -> auth.users.id
  course_id         String   @db.Uuid
  course            Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  material_type     String   @db.VarChar(50)
  file_name         String?  @db.VarChar(500)
  file_url          String?
  mime_type         String?  @db.VarChar(255)
  file_size_bytes   BigInt?
  processing_status String   @default("uploaded") @db.VarChar(30)
  extracted_text    String?
  metadata          Json     @default("{}") @db.JsonB
  uploaded_at       DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @default(now()) @db.Timestamptz

  @@map("subject_materials")
}

// ============================================================
// PART C — Tasks, Steps & Tags
// ============================================================

model TaskTag {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?       @db.Uuid // FK -> auth.users.id
  label      String        @db.VarChar(100)
  color      String?       @db.VarChar(7)
  is_system  Boolean       @default(false)
  created_at DateTime      @default(now()) @db.Timestamptz

  links      TaskTagLink[]

  @@map("task_tags")
}

model Task {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String    @db.Uuid // FK -> auth.users.id
  course_id               String?   @db.Uuid
  course                  Course?   @relation(fields: [course_id], references: [id], onDelete: SetNull)
  parent_task_id          String?   @db.Uuid
  parent_task             Task?     @relation("TaskSubtasks", fields: [parent_task_id], references: [id], onDelete: Cascade)
  subtasks                Task[]    @relation("TaskSubtasks")
  title                   String    @db.VarChar(255)
  description             String?
  task_type               String    @default("assignment") @db.VarChar(50)
  priority                String    @default("medium") @db.VarChar(20)
  status                  String    @default("pending") @db.VarChar(20)
  planner_section         String    @default("anytime") @db.VarChar(20)
  scheduled_start_at      DateTime? @db.Timestamptz
  scheduled_end_at        DateTime? @db.Timestamptz
  due_at                  DateTime? @db.Timestamptz
  estimated_duration_mins Int?
  actual_duration_mins    Int?
  reminder_at             DateTime? @db.Timestamptz
  repeat_rule             String?
  is_micro_task           Boolean   @default(false)
  order_index             Int       @default(0)
  source                  String    @default("manual") @db.VarChar(30)
  metadata                Json      @default("{}") @db.JsonB
  completed_at            DateTime? @db.Timestamptz
  created_at              DateTime  @default(now()) @db.Timestamptz
  updated_at              DateTime  @default(now()) @db.Timestamptz

  tag_links               TaskTagLink[]
  steps                   TaskStep[]
  reschedule_history      TaskRescheduleHistory[]
  focus_sessions          FocusSession[]
  ada_plan_items          AdaGeneratedPlanItem[]
  ada_sessions            AdaSession[]
  calendar_events         CalendarEvent[]
  share_events            ShareEvent[]

  @@map("tasks")
}

model TaskTagLink {
  task_id    String   @db.Uuid
  task       Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  tag_id     String   @db.Uuid
  tag        TaskTag  @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now()) @db.Timestamptz

  @@id([task_id, tag_id])
  @@map("task_tag_links")
}

model TaskStep {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id      String    @db.Uuid
  task         Task      @relation(fields: [task_id], references: [id], onDelete: Cascade)
  title        String    @db.VarChar(500)
  description  String?
  status       String    @default("pending") @db.VarChar(20)
  order_index  Int       @default(0)
  completed_at DateTime? @db.Timestamptz
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @default(now()) @db.Timestamptz

  @@map("task_steps")
}

model TaskRescheduleHistory {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id                String    @db.Uuid
  task                   Task      @relation(fields: [task_id], references: [id], onDelete: Cascade)
  old_scheduled_start_at DateTime? @db.Timestamptz
  old_scheduled_end_at   DateTime? @db.Timestamptz
  new_scheduled_start_at DateTime? @db.Timestamptz
  new_scheduled_end_at   DateTime? @db.Timestamptz
  reason                 String?
  changed_by             String    @default("user") @db.VarChar(30)
  created_at             DateTime  @default(now()) @db.Timestamptz

  @@map("task_reschedule_history")
}

// ============================================================
// PART D — Prism & Focus Sessions
// ============================================================

model PrismPreset {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String              @unique @db.VarChar(100)
  description    String?
  is_system      Boolean             @default(true)
  created_at     DateTime            @default(now()) @db.Timestamptz

  audio_profiles PrismAudioProfile[]
  focus_sessions FocusSession[]

  @@map("prism_presets")
}

model PrismAudioProfile {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String       @unique @db.Uuid // FK -> auth.users.id
  default_preset_id String?      @db.Uuid
  default_preset    PrismPreset? @relation(fields: [default_preset_id], references: [id], onDelete: SetNull)
  volume_level      Int          @default(50) @db.SmallInt
  adaptive_audio    Boolean      @default(true)
  play_in_focus     Boolean      @default(true)
  created_at        DateTime     @default(now()) @db.Timestamptz
  updated_at        DateTime     @default(now()) @db.Timestamptz

  @@map("prism_audio_profiles")
}

model FocusSession {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String        @db.Uuid // FK -> auth.users.id
  task_id               String?       @db.Uuid
  task                  Task?         @relation(fields: [task_id], references: [id], onDelete: SetNull)
  course_id             String?       @db.Uuid
  course                Course?       @relation(fields: [course_id], references: [id], onDelete: SetNull)
  prism_preset_id       String?       @db.Uuid
  prism_preset          PrismPreset?  @relation(fields: [prism_preset_id], references: [id], onDelete: SetNull)
  started_at            DateTime      @default(now()) @db.Timestamptz
  ended_at              DateTime?     @db.Timestamptz
  planned_duration_mins Int?
  actual_duration_mins  Int?
  paused_duration_mins  Int           @default(0)
  interruption_count    Int           @default(0)
  status                String        @default("completed") @db.VarChar(20)
  was_completed         Boolean       @default(false)
  mood_before           Int?          @db.SmallInt
  mood_after            Int?          @db.SmallInt
  session_rating        Int?          @db.SmallInt
  notes                 String?
  metadata              Json          @default("{}") @db.JsonB
  created_at            DateTime      @default(now()) @db.Timestamptz

  mood_checkins         MoodCheckin[]

  @@map("focus_sessions")
}

// ============================================================
// PART E — Mood & Check-ins
// ============================================================

model MoodCheckin {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String        @db.Uuid // FK -> auth.users.id
  focus_session_id String?       @db.Uuid
  focus_session    FocusSession? @relation(fields: [focus_session_id], references: [id], onDelete: SetNull)
  checkin_type     String        @db.VarChar(30)
  mood_score       Int           @db.SmallInt
  mood_label       String?       @db.VarChar(50)
  note             String?
  checkin_date     DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at       DateTime      @default(now()) @db.Timestamptz

  @@map("mood_checkins")
}

// ============================================================
// PART F — Analytics
// ============================================================

model AnalyticsSnapshot {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String   @db.Uuid // FK -> auth.users.id
  week_start          DateTime @db.Date
  focus_minutes_total Int      @default(0)
  tasks_completed     Int      @default(0)
  tasks_created       Int      @default(0)
  productivity_score  Decimal? @db.Decimal(5, 2)
  session_count       Int      @default(0)
  avg_mood            Decimal? @db.Decimal(4, 2)
  streak_at_snapshot  Int      @default(0)
  created_at          DateTime @default(now()) @db.Timestamptz

  @@unique([user_id, week_start])
  @@map("analytics_snapshots")
}

model DailyActivitySnapshot {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String   @db.Uuid // FK -> auth.users.id
  activity_date       DateTime @db.Date
  focus_minutes_total Int      @default(0)
  tasks_completed     Int      @default(0)
  tasks_created       Int      @default(0)
  mood_score_avg      Decimal? @db.Decimal(4, 2)
  focus_session_count Int      @default(0)
  streak_day_number   Int      @default(0)
  created_at          DateTime @default(now()) @db.Timestamptz
  updated_at          DateTime @default(now()) @db.Timestamptz

  @@unique([user_id, activity_date])
  @@map("daily_activity_snapshots")
}

// ============================================================
// PART G — Ada AI
// ============================================================

model AdaSession {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String                 @db.Uuid // FK -> auth.users.id
  course_id    String?                @db.Uuid
  course       Course?                @relation(fields: [course_id], references: [id], onDelete: SetNull)
  task_id      String?                @db.Uuid
  task         Task?                  @relation(fields: [task_id], references: [id], onDelete: SetNull)
  session_type String                 @default("general") @db.VarChar(50)
  title        String?                @db.VarChar(255)
  is_active    Boolean                @default(true)
  context      Json                   @default("{}") @db.JsonB
  started_at   DateTime               @default(now()) @db.Timestamptz
  ended_at     DateTime?              @db.Timestamptz
  created_at   DateTime               @default(now()) @db.Timestamptz
  updated_at   DateTime               @default(now()) @db.Timestamptz

  messages     AdaMessage[]
  plan_items   AdaGeneratedPlanItem[]

  @@map("ada_sessions")
}

model AdaMessage {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ada_session_id    String     @db.Uuid
  ada_session       AdaSession @relation(fields: [ada_session_id], references: [id], onDelete: Cascade)
  role              String     @db.VarChar(20)
  content           String
  attachments       Json       @default("[]") @db.JsonB
  metadata          Json       @default("{}") @db.JsonB
  model             String?    @db.VarChar(100)
  prompt_tokens     Int?
  completion_tokens Int?
  sent_at           DateTime   @default(now()) @db.Timestamptz

  @@map("ada_messages")
}

model AdaGeneratedPlanItem {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ada_session_id   String     @db.Uuid
  ada_session      AdaSession @relation(fields: [ada_session_id], references: [id], onDelete: Cascade)
  task_id          String?    @db.Uuid
  task             Task?      @relation(fields: [task_id], references: [id], onDelete: SetNull)
  title            String     @db.VarChar(500)
  planned_start_at DateTime?  @db.Timestamptz
  planned_end_at   DateTime?  @db.Timestamptz
  status           String     @default("suggested") @db.VarChar(30)
  created_at       DateTime   @default(now()) @db.Timestamptz

  @@map("ada_generated_plan_items")
}

// Agentic runtime (supabase/functions/api/agent/). Session/message references are
// plain uuid columns — the FKs exist in SQL, but modelling the relations here would
// force back-relation fields onto AdaSession/AdaMessage for no query benefit.

model AdaAgentRun {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid // FK -> auth.users.id
  ada_session_id     String    @db.Uuid
  trigger_message_id String?   @db.Uuid
  goal               String
  /// running | awaiting_confirmation | completed | failed | cancelled
  status             String    @default("running") @db.VarChar(30)
  plan               Json      @default("[]") @db.JsonB
  /// Provider-shaped message array, replayed verbatim when a paused run resumes.
  transcript         Json      @default("[]") @db.JsonB
  scratchpad         Json      @default("[]") @db.JsonB
  turns              Int       @default(0)
  prompt_tokens      Int       @default(0)
  completion_tokens  Int       @default(0)
  /// Provider calls made. The prompt is replayed in full each turn, so spend
  /// grows superlinearly in this number — watch it rather than wall-clock.
  llm_calls          Int       @default(0)
  /// null = ran to a natural end. Otherwise deadline | call_budget | turn_budget.
  stopped_reason     String?   @db.VarChar(20)
  error              String?
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @default(now()) @db.Timestamptz

  @@index([user_id])
  @@index([ada_session_id])
  @@index([status])
  @@index([created_at])
  @@map("ada_agent_runs")
}

model AdaPendingAction {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid // FK -> auth.users.id
  ada_session_id String    @db.Uuid
  run_id         String?   @db.Uuid
  message_id     String?   @db.Uuid
  tool_name      String    @db.VarChar(60)
  /// create | update | delete
  operation      String    @db.VarChar(10)
  resource       String    @db.VarChar(40)
  title          String    @db.VarChar(300)
  detail         Json      @default("{}") @db.JsonB
  /// Exact validated tool input; re-validated server-side before execution.
  args           Json      @default("{}") @db.JsonB
  /// pending | approved | rejected | executed | failed | superseded
  status         String    @default("pending") @db.VarChar(20)
  result         Json?
  error          String?
  created_at     DateTime  @default(now()) @db.Timestamptz
  decided_at     DateTime? @db.Timestamptz
  executed_at    DateTime? @db.Timestamptz

  @@index([user_id])
  @@index([ada_session_id])
  @@index([run_id])
  @@index([user_id, status])
  @@map("ada_pending_actions")
}

// ============================================================
// PART H — Calendar Events
// ============================================================

model CalendarEvent {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calendar_connection_id String             @db.Uuid
  calendar_connection    CalendarConnection @relation(fields: [calendar_connection_id], references: [id], onDelete: Cascade)
  user_id                String?            @db.Uuid // FK -> auth.users.id
  task_id                String?            @db.Uuid
  task                   Task?              @relation(fields: [task_id], references: [id], onDelete: SetNull)
  external_event_id      String?            @db.VarChar(500)
  title                  String             @db.VarChar(500)
  description            String?
  starts_at              DateTime           @db.Timestamptz
  ends_at                DateTime?          @db.Timestamptz
  is_all_day             Boolean            @default(false)
  event_source           String             @default("external") @db.VarChar(30)
  sync_status            String             @default("synced") @db.VarChar(30)
  metadata               Json               @default("{}") @db.JsonB
  synced_at              DateTime           @default(now()) @db.Timestamptz
  created_at             DateTime           @default(now()) @db.Timestamptz
  updated_at             DateTime           @default(now()) @db.Timestamptz

  @@map("calendar_events")
}

// ============================================================
// PART I — Referral & Share
// ============================================================

model ReferralCode {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String               @unique @db.Uuid // FK -> auth.users.id
  code        String               @unique @db.VarChar(50)
  is_active   Boolean              @default(true)
  created_at  DateTime             @default(now()) @db.Timestamptz

  redemptions ReferralRedemption[]

  @@map("referral_codes")
}

model ReferralRedemption {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referral_code_id String       @db.Uuid
  referral_code    ReferralCode @relation(fields: [referral_code_id], references: [id], onDelete: Cascade)
  referred_user_id String       @unique @db.Uuid // FK -> auth.users.id
  redeemed_at      DateTime     @default(now()) @db.Timestamptz

  @@map("referral_redemptions")
}

model ShareEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?  @db.Uuid // FK -> auth.users.id
  share_type String   @db.VarChar(50)
  task_id    String?  @db.Uuid
  task       Task?    @relation(fields: [task_id], references: [id], onDelete: SetNull)
  channel    String?  @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz

  @@map("share_events")
}

// ============================================================
// PART J — Ratings & Feedback
// ============================================================

model AppRating {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid // FK -> auth.users.id
  rating      Int      @db.SmallInt
  platform    String?  @db.VarChar(20)
  app_version String?  @db.VarChar(50)
  comment     String?
  created_at  DateTime @default(now()) @db.Timestamptz

  @@map("app_ratings")
}

model AppFeedback {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?  @db.Uuid // FK -> auth.users.id
  feedback_type String   @default("general") @db.VarChar(50)
  text          String
  platform      String?  @db.VarChar(20)
  app_version   String?  @db.VarChar(50)
  metadata      Json     @default("{}") @db.JsonB
  created_at    DateTime @default(now()) @db.Timestamptz

  @@map("app_feedback")
}

// ============================================================
// PART K — Feedback & Roadmap board (nolt parity, phase 1)
// ------------------------------------------------------------
// A SHARED, public feature-request board — NOT per-user tenant-scoped, so these
// models are NOT in TENANT_MODELS and services use raw prisma.* (system path).
// PKs are bigint identity; `ref` is the short public number shown as #ref.
// author_id / user_id / actor_id -> auth.users.id (plain uuid, no Prisma relation).
// ============================================================

model FeedbackStatus {
  key        String  @id
  label      String
  color      String
  sort_order Int     @default(0)
  on_roadmap Boolean @default(true)

  posts FeedbackPost[]

  @@map("feedback_statuses")
}

model FeedbackCategory {
  key   String @id
  label String

  posts FeedbackPost[]

  @@map("feedback_categories")
}

model FeedbackPost {
  id            BigInt            @id @default(autoincrement())
  ref           Int               @unique @default(dbgenerated("nextval('feedback_ref_seq'::regclass)"))
  author_id     String?           @db.Uuid // -> auth.users.id
  title         String
  body          String            @default("")
  status_key    String?           @default("under_review")
  status        FeedbackStatus?   @relation(fields: [status_key], references: [key], onDelete: NoAction, onUpdate: NoAction)
  category_key  String?
  category      FeedbackCategory? @relation(fields: [category_key], references: [key], onDelete: NoAction, onUpdate: NoAction)
  upvotes       Int               @default(0)
  comment_count Int               @default(0)
  pinned        Boolean           @default(false)
  locked        Boolean           @default(false)
  approved      Boolean           @default(true)
  merged_into   BigInt?
  merged_target FeedbackPost?     @relation("FeedbackMerge", fields: [merged_into], references: [id], onDelete: NoAction, onUpdate: NoAction)
  merged_from   FeedbackPost[]    @relation("FeedbackMerge")
  created_at    DateTime          @default(now()) @db.Timestamptz
  updated_at    DateTime          @default(now()) @db.Timestamptz

  votes          FeedbackVote[]
  comments       FeedbackComment[]
  status_changes FeedbackStatusChange[]
  subscriptions  FeedbackSubscription[]
  admin_notes    FeedbackAdminNote[]
  changelog      ChangelogEntry[]

  @@index([status_key])
  @@index([category_key])
  @@index([upvotes(sort: Desc)])
  @@map("feedback_posts")
}

model FeedbackVote {
  post_id    BigInt
  post       FeedbackPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user_id    String       @db.Uuid // -> auth.users.id
  created_at DateTime     @default(now()) @db.Timestamptz

  @@id([post_id, user_id])
  @@map("feedback_votes")
}

model FeedbackComment {
  id         BigInt           @id @default(autoincrement())
  post_id    BigInt
  post       FeedbackPost     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  author_id  String?          @db.Uuid // -> auth.users.id
  parent_id  BigInt?
  parent     FeedbackComment? @relation("FeedbackCommentThread", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies    FeedbackComment[] @relation("FeedbackCommentThread")
  body       String
  is_team    Boolean          @default(false)
  deleted_at DateTime?        @db.Timestamptz
  created_at DateTime         @default(now()) @db.Timestamptz

  reactions FeedbackCommentReaction[]

  @@index([post_id])
  @@map("feedback_comments")
}

model FeedbackCommentReaction {
  comment_id BigInt
  comment    FeedbackComment @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user_id    String          @db.Uuid // -> auth.users.id
  emoji      String

  @@id([comment_id, user_id, emoji])
  @@map("feedback_comment_reactions")
}

model FeedbackStatusChange {
  id          BigInt       @id @default(autoincrement())
  post_id     BigInt
  post        FeedbackPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  from_status String?
  to_status   String
  actor_id    String?      @db.Uuid // -> auth.users.id
  note        String?
  created_at  DateTime     @default(now()) @db.Timestamptz

  @@index([post_id])
  @@map("feedback_status_changes")
}

model FeedbackSubscription {
  post_id    BigInt
  post       FeedbackPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user_id    String       @db.Uuid // -> auth.users.id
  created_at DateTime     @default(now()) @db.Timestamptz

  @@id([post_id, user_id])
  @@map("feedback_subscriptions")
}

model FeedbackAdminNote {
  id         BigInt       @id @default(autoincrement())
  post_id    BigInt
  post       FeedbackPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  author_id  String?      @db.Uuid // -> auth.users.id
  body       String
  created_at DateTime     @default(now()) @db.Timestamptz

  @@map("feedback_admin_notes")
}

model ChangelogEntry {
  id           BigInt        @id @default(autoincrement())
  title        String
  body         String
  source_post  BigInt?
  source       FeedbackPost? @relation(fields: [source_post], references: [id], onDelete: NoAction, onUpdate: NoAction)
  published_at DateTime?     @db.Timestamptz

  @@map("changelog_entries")
}
