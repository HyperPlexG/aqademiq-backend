NODE_ENV=development
PORT=8080
# Debug-only endpoint: POST /v1/debug/sql-smoke-test
ENABLE_SQL_SMOKE_TEST=0
# GCP / region-pinned (EU/UAE per §4.9)
GCP_PROJECT_ID=
GCP_REGION=europe-west1

# ---- Supabase (identity + Postgres + Storage) — see SUPABASE_INTEGRATION.md ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret (bypasses RLS). Dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres via Supabase. Use the POOLER for both (the direct host db.<ref>.supabase.co
# is IPv6-only). Copy the exact pooler host + password from Dashboard > Database.
# Pooled/transaction mode (6543) for the app; session mode (5432) for prisma migrate.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres
# Memorystore (Redis) — cache/queue/rate-limit/pubsub/deny-list  §7
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_AUTH_STRING=
REDIS_CA_CERT_PATH=
# Auth: Supabase Auth (since 2026-07-18) — tokens are verified against
# SUPABASE_URL's JWKS; no local keys needed. The RS256 vars below are LEGACY
# (custom-JWT era) and unused by the current code.
# JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
# ACCESS_TTL_SECONDS=900
# REFRESH_TTL_DAYS=60
# Claude via Vertex AI (§4.3) — legacy provider when AI_PROVIDER=vertex|anthropic
VERTEX_REGION=us-east5
CLAUDE_OPUS_MODEL=claude-opus-4-8
CLAUDE_HAIKU_MODEL=claude-haiku-4-5
# AI provider: gemini_vertex | gemini_studio | anthropic | vertex | none
# Auto-detected if blank: GOOGLE_AI_API_KEY → gemini_studio, ANTHROPIC_API_KEY → anthropic, GCP_PROJECT_ID → vertex (Claude).
AI_PROVIDER=
# Gemini 2.5 Flash (used when AI_PROVIDER=gemini_vertex or gemini_studio)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Cloud Storage (§4.4) — private user bucket + public Prism CDN bucket
GCS_USER_BUCKET=
GCS_PRISM_CDN_BUCKET=
# OAuth SSO (§2.1) — comma-separated accepted audiences (web/iOS/Android client ids)
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=
# Email (§7) transactional provider — Resend. Get a key at https://resend.com
# (starts with "re_"). Leave blank in dev to fall back to console/dev_code.
# EMAIL_FROM must be a verified sender/domain in your Resend account.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=no-reply@aqademiq.app
# Push (§4.5)
FCM_SERVICE_ACCOUNT_PATH=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
