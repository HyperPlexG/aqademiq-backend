{
  "x-overlay-note": [
    "Endpoints that exist ONLY in the deployed Deno/Hono tree (supabase/functions/api/),",
    "with no NestJS equivalent in src/. openapi.json is generated by booting the NestJS",
    "app (EMIT_OPENAPI=1), so it structurally cannot describe these: Ada's agent — the",
    "confirmation gate and durable memory — has no counterpart in src/features/ada/,",
    "which still holds the older single-shot propose_plan design.",
    "",
    "Hand-maintained, and merged over the generated file by scripts/merge-openapi.mjs.",
    "Keeping them here rather than editing openapi.json directly means the next",
    "regeneration cannot silently drop them — which is exactly what happened to the",
    "pending-action routes: they shipped, the spec was regenerated, and they vanished.",
    "",
    "Overlay paths WIN over generated ones, so this file also carries corrections to",
    "endpoints NestJS does describe but describes wrongly (see the 200-vs-201 fixes)."
  ],
  "paths": {
    "/v1/ada/pending-actions": {
      "get": {
        "operationId": "AdaController_pendingActions",
        "summary": "Changes Ada has proposed and is waiting on",
        "description": "Every create/update/delete the agent wants to make is parked here until the user approves it. Nothing in the user's data has changed while an action is `pending`.",
        "parameters": [
          {
            "name": "conversation_id",
            "required": false,
            "in": "query",
            "description": "Limit to one conversation. Omit for everything outstanding.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Outstanding proposals, oldest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "actions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AdaPendingActionDto"
                      }
                    }
                  },
                  "required": [
                    "actions"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/ada/actions/{id}/approve": {
      "post": {
        "operationId": "AdaController_approveAction",
        "summary": "Approve one proposed change and apply it",
        "description": "Re-validates the action's arguments against CURRENT state before executing, so an approval granted minutes ago cannot act on since-deleted data. Once nothing in the run is still undecided the agent resumes and its follow-up turn is returned as `message`. A failure to execute is reported in `error` rather than thrown — the approval was legitimate, the world simply moved on.",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The decided action, plus Ada's follow-up turn when the run resumed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "action": {
                      "$ref": "#/components/schemas/AdaPendingActionDto"
                    },
                    "error": {
                      "type": "string",
                      "nullable": true,
                      "description": "Set when execution failed after approval."
                    },
                    "message": {
                      "$ref": "#/components/schemas/AdaMessageDto"
                    }
                  },
                  "required": [
                    "action"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No such action for this user."
          },
          "409": {
            "description": "The action has already been decided."
          }
        }
      }
    },
    "/v1/ada/actions/{id}/reject": {
      "post": {
        "operationId": "AdaController_rejectAction",
        "summary": "Decline one proposed change",
        "description": "Nothing is written. The agent resumes once the run has nothing left undecided and adapts rather than re-proposing.",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The declined action, plus Ada's follow-up turn when the run resumed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "action": {
                      "$ref": "#/components/schemas/AdaPendingActionDto"
                    },
                    "message": {
                      "$ref": "#/components/schemas/AdaMessageDto"
                    }
                  },
                  "required": [
                    "action"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No such action for this user."
          },
          "409": {
            "description": "The action has already been decided."
          }
        }
      }
    },
    "/v1/ada/conversations/{id}/actions/decide": {
      "post": {
        "operationId": "AdaController_decideAllActions",
        "summary": "Approve or decline every outstanding change in a conversation",
        "description": "Applied in proposal order, not concurrently: a plan often creates a subject and then tasks against it, so running them in parallel would race.",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "approve": {
                    "type": "boolean",
                    "description": "true applies them all, false declines them all."
                  }
                },
                "required": [
                  "approve"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Every decided action, and any follow-up turns the resumed runs produced.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "actions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AdaPendingActionDto"
                      }
                    },
                    "decided": {
                      "type": "integer"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AdaMessageDto"
                      }
                    }
                  },
                  "required": [
                    "actions",
                    "decided"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "`approve` was not a boolean."
          }
        }
      }
    },
    "/v1/ada/memories": {
      "get": {
        "operationId": "AdaController_memories",
        "summary": "What Ada has stored about this user",
        "description": "Durable facts carried into every conversation. `source` distinguishes what the user stated outright from what Ada inferred — the pair a user most needs to tell apart when deciding what to remove.",
        "responses": {
          "200": {
            "description": "Stored memories, grouped by kind then most recently updated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "memories": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AdaMemoryDto"
                      }
                    }
                  },
                  "required": [
                    "memories"
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "AdaController_clearMemories",
        "summary": "Forget everything about this user",
        "responses": {
          "200": {
            "description": "How many memories were removed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "cleared"
                    },
                    "deleted": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "status",
                    "deleted"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/ada/memories/{id}": {
      "delete": {
        "operationId": "AdaController_deleteMemory",
        "summary": "Forget one memory",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "deleted"
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "status",
                    "id"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No such memory for this user."
          }
        }
      }
    },
    "/v1/ada/conversations/{id}/archive": {
      "post": {
        "operationId": "AdaController_archive",
        "summary": "Archive a conversation",
        "description": "Corrected from the generated 201: nothing is created, an existing row is flagged inactive.",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Archived."
          }
        }
      }
    },
    "/v1/ada/chat/clear": {
      "post": {
        "operationId": "AdaController_clear",
        "summary": "Archive every active conversation",
        "description": "Corrected from the generated 201: nothing is created.",
        "responses": {
          "200": {
            "description": "Cleared."
          }
        }
      }
    },
    "/v1/tasks/{occ}/steps": {
      "delete": {
        "operationId": "TasksController_clearSteps",
        "summary": "Remove every microstep from a task occurrence",
        "description": "Backs the breakdown toggle in the task editor: switching it off has to take the existing microsteps away, or the switch reads \"off\" while the plan still shows them and the next save appends a second set. Idempotent - deleting from a task with no steps returns `deleted: 0`. For a repeating occurrence the steps live on the row that the breakdown materialised for that date, and only that date is affected.",
        "tags": [
          "tasks"
        ],
        "parameters": [
          {
            "name": "occ",
            "required": true,
            "in": "path",
            "description": "Task id, or `<task-id>@<YYYY-MM-DD>` for one occurrence of a repeating task.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "How many steps were removed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "integer",
                      "example": 3
                    }
                  },
                  "required": [
                    "deleted"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No such task for this user."
          }
        }
      }
    },
    "/v1/tasks/{occ}/steps/{stepId}": {
      "patch": {
        "operationId": "TasksController_setStepDone",
        "summary": "Tick a micro-step off, or un-tick it",
        "description": "There was previously no way to complete a micro-step: the rows rendered a circle that looked tappable and did nothing, so a breakdown could be read but never worked through. `done` is explicit rather than a server-side toggle, so a retried request cannot flip the step back. The step must belong to the given occurrence - for a repeating task that means the row the breakdown materialised for that date.",
        "tags": [
          "tasks"
        ],
        "parameters": [
          {
            "name": "occ",
            "required": true,
            "in": "path",
            "description": "Task id, or `<task-id>@<YYYY-MM-DD>` for one occurrence of a repeating task.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stepId",
            "required": true,
            "in": "path",
            "description": "Step id, from the occurrence's `steps[]`.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "done": {
                    "type": "boolean",
                    "description": "Target state, not a toggle."
                  }
                },
                "required": [
                  "done"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated step.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "title": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string",
                      "nullable": true
                    },
                    "duration_seconds": {
                      "type": "integer"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "PENDING",
                        "COMPLETE"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`done` missing or not a boolean."
          },
          "404": {
            "description": "No such step on this occurrence for this user."
          }
        }
      }
    },
    "/v1/focus-sessions": {
      "get": {
        "operationId": "FocusController_range",
        "summary": "Completed focus sessions in a date window",
        "description": "The table was write-only over the wire: every duration, time of day, Prism mode and end mood went in and nothing came back. Completed sessions only, newest first - which is the shape of focus_sessions_user_completed_started_idx, so this is an index scan rather than the seq scan an unfiltered read would be.",
        "parameters": [
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "YYYY-MM-DD. Defaults to six days before `to`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "YYYY-MM-DD. Defaults to today.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Completed sessions in the window, newest first. Capped at 500 rows.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "sessions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "description": "The object POST /v1/focus-sessions returns, plus started_at."
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Malformed date, `from` after `to`, or a window wider than 92 days. A wide window is refused rather than silently truncated."
          }
        }
      }
    },
    "/v1/me/weekly-report": {
      "get": {
        "operationId": "StatsController_weeklyReport",
        "summary": "Every fact the weekly report draws, in one read",
        "description": "One endpoint rather than five composed client-side: the report is a single screen that must appear all at once, and has_activity has to be decided from the union of every kind of evidence in one place - split across endpoints, any disagreement between the two draws a day someone worked as empty.",
        "parameters": [
          {
            "name": "week_start",
            "required": false,
            "in": "query",
            "description": "Any date inside the week (YYYY-MM-DD); the server snaps to Monday. Defaults to the current week.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The facts for the week.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeeklyReportDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdaActionFieldDto": {
        "type": "object",
        "description": "One line of the before/after diff shown on a confirmation card.",
        "properties": {
          "label": {
            "type": "string",
            "example": "Date"
          },
          "from": {
            "type": "string",
            "nullable": true,
            "description": "Absent when the field is being set for the first time."
          },
          "to": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "label"
        ]
      },
      "AdaPendingActionDto": {
        "type": "object",
        "description": "A change Ada wants to make, waiting on the user's decision.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "message_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "The assistant message whose card this is."
          },
          "tool_name": {
            "type": "string",
            "example": "create_task"
          },
          "operation": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete"
            ]
          },
          "resource": {
            "type": "string",
            "enum": [
              "task",
              "subject",
              "semester",
              "study_tag",
              "mood",
              "profile",
              "settings",
              "memory"
            ]
          },
          "title": {
            "type": "string",
            "example": "Add task “Review lecture notes”"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdaActionFieldDto"
            }
          },
          "warning": {
            "type": "string",
            "nullable": true,
            "description": "Irreversible or wide-reaching effects, and scheduling clashes. Shown in red."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "executed",
              "rejected",
              "failed",
              "superseded"
            ]
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "decided_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "conversation_id",
          "tool_name",
          "operation",
          "resource",
          "title",
          "fields",
          "status",
          "created_at"
        ]
      },
      "AdaMemoryDto": {
        "type": "object",
        "description": "One durable fact Ada holds about the user, across conversations.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "preference",
              "constraint",
              "pattern",
              "goal",
              "fact"
            ],
            "description": "preference = how they like to work; constraint = a fixed commitment; pattern = something observed repeatedly; goal = what they are working toward; fact = durable context."
          },
          "content": {
            "type": "string",
            "example": "Prefers deep work before noon"
          },
          "subject_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Set when the memory applies to one subject only."
          },
          "source": {
            "type": "string",
            "enum": [
              "user",
              "ada"
            ],
            "description": "`user` = they stated it outright. `ada` = inferred from behaviour, so weaker — surface this distinction in the UI."
          },
          "confidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kind",
          "content",
          "source",
          "confidence",
          "created_at",
          "updated_at"
        ]
      },
      "AdaMessageDto": {
        "type": "object",
        "description": "One turn in an Ada conversation.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_user": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          },
          "plan": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "object"
            },
            "description": "Legacy pre-agent propose_plan payload; drives the \"Add to my plan\" button."
          },
          "plan_footer": {
            "type": "string",
            "nullable": true
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "agent_status": {
            "type": "string",
            "nullable": true,
            "enum": [
              "completed",
              "awaiting_confirmation",
              "failed",
              null
            ]
          },
          "agent_plan": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "object",
              "properties": {
                "step": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdaPendingActionDto"
            }
          },
          "attachments": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "object"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "is_user",
          "text",
          "created_at"
        ]
      },
      "WeeklyReportDayDto": {
        "type": "object",
        "description": "One band of the core. Always seven of these, Monday first.",
        "properties": {
          "date": {
            "type": "string",
            "example": "2026-08-31"
          },
          "weekday": {
            "type": "integer",
            "description": "1 = Monday to 7 = Sunday.",
            "minimum": 1,
            "maximum": 7
          },
          "mood_index": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "maximum": 4,
            "description": "0-4 on the shipped ramp, or null when nothing was logged. NOTE: 0 is a real mood and is falsy - a truthiness check here turns the worst day someone logged into a day they did not log."
          },
          "has_activity": {
            "type": "boolean",
            "description": "A UNION, not an activity-ledger lookup: true if the day carries a ledger row OR a completed task OR a focus session OR a mood check-in. Reading the ledger alone was measured to miss 31 of the 48 days on which someone finished a focus session, across 23 users."
          },
          "tasks_completed": {
            "type": "integer"
          },
          "focus_minutes": {
            "type": "integer"
          },
          "focus_sessions": {
            "type": "integer"
          },
          "is_future": {
            "type": "boolean",
            "description": "A day later in the week than today. Not active and NOT a gap - drawing it as \"nothing logged\" tells someone on Thursday that they already missed Friday, Saturday and Sunday."
          }
        }
      },
      "WeeklyReportDto": {
        "type": "object",
        "description": "Facts only. No sentence, label or adjective crosses the wire - all copy is templated client-side where a banned-vocabulary lint can see it as a string literal.",
        "properties": {
          "week_start": {
            "type": "string",
            "example": "2026-08-31"
          },
          "week_end": {
            "type": "string",
            "example": "2026-09-06"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WeeklyReportDayDto"
            }
          },
          "shape": {
            "type": "string",
            "enum": [
              "empty",
              "single",
              "steady",
              "front_loaded",
              "back_loaded",
              "clustered",
              "scattered"
            ],
            "description": "The shape of the week, classified from WHICH days carried work and never from how much. A shape drawn from volume ranks days against each other, so one thin day would drag the whole description down."
          },
          "active_days": {
            "type": "integer",
            "description": "The hero numeral: days THIS WEEK that carried work, 0-7. A weekly report whose headline is a lifetime total is not a weekly report."
          },
          "days_on_board": {
            "type": "integer",
            "description": "Lifetime days on the board. Kept because it is the only count here that cannot go down; deliberately not headlined."
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "subject_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "nullable": true,
                  "description": "Null when the subject was deleted after the work happened. It keeps its share; the client draws an unlabelled outline and never names it in copy."
                },
                "color": {
                  "type": "string",
                  "nullable": true
                },
                "focus_minutes": {
                  "type": "integer"
                },
                "tasks_completed": {
                  "type": "integer"
                },
                "share": {
                  "type": "number",
                  "description": "0-1, in whichever unit subject_basis names."
                }
              }
            }
          },
          "subject_basis": {
            "type": "string",
            "enum": [
              "focus_minutes",
              "tasks_completed"
            ]
          },
          "unattributed_focus_minutes": {
            "type": "integer"
          },
          "unattributed_tasks_completed": {
            "type": "integer"
          },
          "moment": {
            "type": "object",
            "nullable": true,
            "description": "One concrete thing that happened - a named task on a named day, never an aggregate.",
            "properties": {
              "kind": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "subject_id": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "recovery": {
            "type": "object",
            "nullable": true,
            "description": "Null rather than negative. The card is positive-only and the enforcement is server-side, so the number simply does not exist when it points the wrong way. Do not synthesise one from before_avg/after_avg.",
            "properties": {
              "sessions": {
                "type": "integer"
              },
              "before_avg": {
                "type": "number"
              },
              "after_avg": {
                "type": "number"
              },
              "lift": {
                "type": "number"
              }
            }
          },
          "longest_session": {
            "type": "object",
            "nullable": true,
            "properties": {
              "minutes": {
                "type": "integer"
              },
              "date": {
                "type": "string"
              },
              "task_title": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "held_minutes": {
            "type": "integer",
            "description": "Paused minutes, reported as a kept quantity."
          },
          "prism_mix": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "preset_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "sessions": {
                  "type": "integer"
                },
                "share": {
                  "type": "number"
                }
              }
            }
          },
          "rhythm_weekdays": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Weekdays (1-7) that reliably carry work. Empty until there are 3+ weeks of history, which is most accounts."
          },
          "focus_minutes": {
            "type": "integer"
          },
          "focus_sessions": {
            "type": "integer"
          },
          "tasks_completed": {
            "type": "integer"
          },
          "elapsed_days": {
            "type": "integer",
            "description": "Days the week has had so far - 4 on a Thursday, 7 once it is over. `shape` is classified against these, not against seven."
          }
        }
      }
    }
  }
}
