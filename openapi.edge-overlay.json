{
  "x-overlay-note": [
    "Endpoints that exist ONLY in the deployed Deno/Hono tree (supabase/functions/api/),",
    "with no NestJS equivalent in src/. openapi.json is generated by booting the NestJS",
    "app (EMIT_OPENAPI=1), so it structurally cannot describe these: Ada's agent — the",
    "confirmation gate and durable memory — has no counterpart in src/features/ada/,",
    "which still holds the older single-shot propose_plan design.",
    "",
    "Hand-maintained, and merged over the generated file by scripts/merge-openapi.mjs.",
    "Keeping them here rather than editing openapi.json directly means the next",
    "regeneration cannot silently drop them — which is exactly what happened to the",
    "pending-action routes: they shipped, the spec was regenerated, and they vanished.",
    "",
    "Overlay paths WIN over generated ones, so this file also carries corrections to",
    "endpoints NestJS does describe but describes wrongly (see the 200-vs-201 fixes)."
  ],
  "paths": {
    "/v1/ada/pending-actions": {
      "get": {
        "operationId": "AdaController_pendingActions",
        "summary": "Changes Ada has proposed and is waiting on",
        "description": "Every create/update/delete the agent wants to make is parked here until the user approves it. Nothing in the user's data has changed while an action is `pending`.",
        "parameters": [
          {
            "name": "conversation_id",
            "required": false,
            "in": "query",
            "description": "Limit to one conversation. Omit for everything outstanding.",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Outstanding proposals, oldest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "actions": { "type": "array", "items": { "$ref": "#/components/schemas/AdaPendingActionDto" } }
                  },
                  "required": ["actions"]
                }
              }
            }
          }
        }
      }
    },
    "/v1/ada/actions/{id}/approve": {
      "post": {
        "operationId": "AdaController_approveAction",
        "summary": "Approve one proposed change and apply it",
        "description": "Re-validates the action's arguments against CURRENT state before executing, so an approval granted minutes ago cannot act on since-deleted data. Once nothing in the run is still undecided the agent resumes and its follow-up turn is returned as `message`. A failure to execute is reported in `error` rather than thrown — the approval was legitimate, the world simply moved on.",
        "parameters": [
          { "name": "id", "required": true, "in": "path", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "The decided action, plus Ada's follow-up turn when the run resumed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "action": { "$ref": "#/components/schemas/AdaPendingActionDto" },
                    "error": { "type": "string", "nullable": true, "description": "Set when execution failed after approval." },
                    "message": { "$ref": "#/components/schemas/AdaMessageDto" }
                  },
                  "required": ["action"]
                }
              }
            }
          },
          "404": { "description": "No such action for this user." },
          "409": { "description": "The action has already been decided." }
        }
      }
    },
    "/v1/ada/actions/{id}/reject": {
      "post": {
        "operationId": "AdaController_rejectAction",
        "summary": "Decline one proposed change",
        "description": "Nothing is written. The agent resumes once the run has nothing left undecided and adapts rather than re-proposing.",
        "parameters": [
          { "name": "id", "required": true, "in": "path", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "The declined action, plus Ada's follow-up turn when the run resumed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "action": { "$ref": "#/components/schemas/AdaPendingActionDto" },
                    "message": { "$ref": "#/components/schemas/AdaMessageDto" }
                  },
                  "required": ["action"]
                }
              }
            }
          },
          "404": { "description": "No such action for this user." },
          "409": { "description": "The action has already been decided." }
        }
      }
    },
    "/v1/ada/conversations/{id}/actions/decide": {
      "post": {
        "operationId": "AdaController_decideAllActions",
        "summary": "Approve or decline every outstanding change in a conversation",
        "description": "Applied in proposal order, not concurrently: a plan often creates a subject and then tasks against it, so running them in parallel would race.",
        "parameters": [
          { "name": "id", "required": true, "in": "path", "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "approve": { "type": "boolean", "description": "true applies them all, false declines them all." } },
                "required": ["approve"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Every decided action, and any follow-up turns the resumed runs produced.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "actions": { "type": "array", "items": { "$ref": "#/components/schemas/AdaPendingActionDto" } },
                    "decided": { "type": "integer" },
                    "messages": { "type": "array", "items": { "$ref": "#/components/schemas/AdaMessageDto" } }
                  },
                  "required": ["actions", "decided"]
                }
              }
            }
          },
          "422": { "description": "`approve` was not a boolean." }
        }
      }
    },
    "/v1/ada/memories": {
      "get": {
        "operationId": "AdaController_memories",
        "summary": "What Ada has stored about this user",
        "description": "Durable facts carried into every conversation. `source` distinguishes what the user stated outright from what Ada inferred — the pair a user most needs to tell apart when deciding what to remove.",
        "responses": {
          "200": {
            "description": "Stored memories, grouped by kind then most recently updated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "memories": { "type": "array", "items": { "$ref": "#/components/schemas/AdaMemoryDto" } }
                  },
                  "required": ["memories"]
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "AdaController_clearMemories",
        "summary": "Forget everything about this user",
        "responses": {
          "200": {
            "description": "How many memories were removed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "cleared" },
                    "deleted": { "type": "integer" }
                  },
                  "required": ["status", "deleted"]
                }
              }
            }
          }
        }
      }
    },
    "/v1/ada/memories/{id}": {
      "delete": {
        "operationId": "AdaController_deleteMemory",
        "summary": "Forget one memory",
        "parameters": [
          { "name": "id", "required": true, "in": "path", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Removed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "deleted" },
                    "id": { "type": "string", "format": "uuid" }
                  },
                  "required": ["status", "id"]
                }
              }
            }
          },
          "404": { "description": "No such memory for this user." }
        }
      }
    },
    "/v1/ada/conversations/{id}/archive": {
      "post": {
        "operationId": "AdaController_archive",
        "summary": "Archive a conversation",
        "description": "Corrected from the generated 201: nothing is created, an existing row is flagged inactive.",
        "parameters": [
          { "name": "id", "required": true, "in": "path", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": { "200": { "description": "Archived." } }
      }
    },
    "/v1/ada/chat/clear": {
      "post": {
        "operationId": "AdaController_clear",
        "summary": "Archive every active conversation",
        "description": "Corrected from the generated 201: nothing is created.",
        "responses": { "200": { "description": "Cleared." } }
      }
    }
  },
  "components": {
    "schemas": {
      "AdaActionFieldDto": {
        "type": "object",
        "description": "One line of the before/after diff shown on a confirmation card.",
        "properties": {
          "label": { "type": "string", "example": "Date" },
          "from": { "type": "string", "nullable": true, "description": "Absent when the field is being set for the first time." },
          "to": { "type": "string", "nullable": true }
        },
        "required": ["label"]
      },
      "AdaPendingActionDto": {
        "type": "object",
        "description": "A change Ada wants to make, waiting on the user's decision.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "conversation_id": { "type": "string", "format": "uuid" },
          "run_id": { "type": "string", "format": "uuid", "nullable": true },
          "message_id": { "type": "string", "format": "uuid", "nullable": true, "description": "The assistant message whose card this is." },
          "tool_name": { "type": "string", "example": "create_task" },
          "operation": { "type": "string", "enum": ["create", "update", "delete"] },
          "resource": { "type": "string", "enum": ["task", "subject", "semester", "study_tag", "mood", "profile", "settings", "memory"] },
          "title": { "type": "string", "example": "Add task “Review lecture notes”" },
          "fields": { "type": "array", "items": { "$ref": "#/components/schemas/AdaActionFieldDto" } },
          "warning": { "type": "string", "nullable": true, "description": "Irreversible or wide-reaching effects, and scheduling clashes. Shown in red." },
          "status": { "type": "string", "enum": ["pending", "approved", "executed", "rejected", "failed", "superseded"] },
          "error": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "decided_at": { "type": "string", "format": "date-time", "nullable": true }
        },
        "required": ["id", "conversation_id", "tool_name", "operation", "resource", "title", "fields", "status", "created_at"]
      },
      "AdaMemoryDto": {
        "type": "object",
        "description": "One durable fact Ada holds about the user, across conversations.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "kind": {
            "type": "string",
            "enum": ["preference", "constraint", "pattern", "goal", "fact"],
            "description": "preference = how they like to work; constraint = a fixed commitment; pattern = something observed repeatedly; goal = what they are working toward; fact = durable context."
          },
          "content": { "type": "string", "example": "Prefers deep work before noon" },
          "subject_id": { "type": "string", "format": "uuid", "nullable": true, "description": "Set when the memory applies to one subject only." },
          "source": { "type": "string", "enum": ["user", "ada"], "description": "`user` = they stated it outright. `ada` = inferred from behaviour, so weaker — surface this distinction in the UI." },
          "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
          "expires_at": { "type": "string", "format": "date-time", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "kind", "content", "source", "confidence", "created_at", "updated_at"]
      },
      "AdaMessageDto": {
        "type": "object",
        "description": "One turn in an Ada conversation.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "is_user": { "type": "boolean" },
          "text": { "type": "string" },
          "plan": { "type": "array", "nullable": true, "items": { "type": "object" }, "description": "Legacy pre-agent propose_plan payload; drives the \"Add to my plan\" button." },
          "plan_footer": { "type": "string", "nullable": true },
          "run_id": { "type": "string", "format": "uuid", "nullable": true },
          "agent_status": { "type": "string", "nullable": true, "enum": ["completed", "awaiting_confirmation", "failed", null] },
          "agent_plan": { "type": "array", "nullable": true, "items": { "type": "object", "properties": { "step": { "type": "string" }, "status": { "type": "string" } } } },
          "actions": { "type": "array", "items": { "$ref": "#/components/schemas/AdaPendingActionDto" } },
          "attachments": { "type": "array", "nullable": true, "items": { "type": "object" } },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "is_user", "text", "created_at"]
      }
    }
  }
}
